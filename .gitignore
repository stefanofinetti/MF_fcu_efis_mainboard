# ─── SketchUp ───────────────────────────────────────────────────────────
# Auto-backup: near-copy of the .skp from the previous save. Binary, so
# git would store a whole new blob every time one is touched.
*.skb

# ─── KiCad: generated files and per-user state ──────────────────────────
*.kicad_prl
fp-info-cache
*-backups/
# auto-backups: the suffix is -bak with a hyphen, not a .bak extension
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_pro-bak
*.lck
~*.lck

# ─── Fabrication output: regenerated by the Fabrication Toolkit ─────────
production/
*.gbr
*.gbrjob
*.drl
*.zip
*.net

# ─── Editors and OS ─────────────────────────────────────────────────────
.history/
__pycache__/
.DS_Store
*.tmp
*.swp
*.log
autosave*
